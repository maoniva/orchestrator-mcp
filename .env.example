# The running T3 Code environment.
T3_BASE_URL=http://127.0.0.1:3773
T3_BEARER_TOKEN=replace-with-a-scoped-t3-token

# This MCP server. It binds to loopback by default.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=3939

# Optional protection for the MCP endpoint itself. Required for non-loopback binds.
# ORCHESTRATOR_MCP_BEARER_TOKEN=replace-with-a-different-secret
# ORCHESTRATOR_ALLOWED_HOSTS=localhost,127.0.0.1

# T3 request timeout in milliseconds.
T3_REQUEST_TIMEOUT_MS=15000
